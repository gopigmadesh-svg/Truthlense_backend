{
    "info": {
        "_postman_id": "truthlens-api-collection-v1",
        "name": "TruthLens Complete Backend APIs",
        "description": "Production-ready Postman collection for the TruthLens Android app. Covers Authentication (Signup, Login, OTP, Forgot/Reset Password), User Profile, Claim Analysis, Scan History, Saved Articles, and App Settings.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "0. Database Setup",
            "item": [
                {
                    "name": "Setup Database & Tables",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/setup_database.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["setup_database.php"]
                        }
                    }
                }
            ]
        },
        {
            "name": "1. Authentication",
            "item": [
                {
                    "name": "1.1 Sign Up",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Alex Morgan\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/signup.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "signup.php"]
                        }
                    }
                },
                {
                    "name": "1.2 Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"alex@example.com\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "login.php"]
                        }
                    }
                },
                {
                    "name": "1.3 Verify OTP",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"alex@example.com\",\n  \"otp\": \"123456\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/verify_otp.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "verify_otp.php"]
                        }
                    }
                },
                {
                    "name": "1.4 Forgot / Reset Password",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"alex@example.com\",\n  \"new_password\": \"NewPass123!\",\n  \"confirm_password\": \"NewPass123!\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/forgot_password.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "forgot_password.php"]
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Profile",
            "item": [
                {
                    "name": "2.1 Get Profile",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/profile/get_profile.php?user_id={{userId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["profile", "get_profile.php"],
                            "query": [{ "key": "user_id", "value": "{{userId}}" }]
                        }
                    }
                },
                {
                    "name": "2.2 Update Profile",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"user_id\": {{userId}},\n  \"name\": \"Alex Morgan, PhD\",\n  \"bio\": \"Senior Digital Media Researcher\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/profile/update_profile.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["profile", "update_profile.php"]
                        }
                    }
                },
                {
                    "name": "2.3 Upload Profile Picture",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                { "key": "user_id", "value": "{{userId}}", "type": "text" },
                                { "key": "email", "value": "alex@example.com", "type": "text" },
                                { "key": "profile_picture", "type": "file", "src": "" }
                            ]
                        },
                        "url": {
                            "raw": "{{baseUrl}}/upload_profile_picture.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["upload_profile_picture.php"]
                        }
                    }
                }
            ]
        },
        {
            "name": "3. News & Claim Analysis",
            "item": [
                {
                    "name": "3.1 Analyze Claim (Text/News)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"user_id\": {{userId}},\n  \"content\": \"Recent study published in peer-reviewed scientific journal confirms breakthrough in clean energy.\",\n  \"scan_type\": \"news\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/analysis/analyze_claim.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["analysis", "analyze_claim.php"]
                        }
                    }
                },
                {
                    "name": "3.2 Get Recent Scans History",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/analysis/get_recent_scans.php?user_id={{userId}}&limit=10",
                            "host": ["{{baseUrl}}"],
                            "path": ["analysis", "get_recent_scans.php"],
                            "query": [
                                { "key": "user_id", "value": "{{userId}}" },
                                { "key": "limit", "value": "10" }
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "4. Saved Articles",
            "item": [
                {
                    "name": "4.1 Save Article Bookmark",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"user_id\": {{userId}},\n  \"title\": \"Fact Check: Misleading energy claim verified\",\n  \"summary\": \"Debunking recent viral post regarding renewable subsidies.\",\n  \"source\": \"Global Fact Check\",\n  \"url\": \"https://example.com/fact-check\",\n  \"trust_score\": 88\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/articles/save_article.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["articles", "save_article.php"]
                        }
                    }
                },
                {
                    "name": "4.2 Get Saved Articles",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/articles/get_saved.php?user_id={{userId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["articles", "get_saved.php"],
                            "query": [{ "key": "user_id", "value": "{{userId}}" }]
                        }
                    }
                },
                {
                    "name": "4.3 Remove Saved Article",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"user_id\": {{userId}},\n  \"article_id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/articles/remove_saved.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["articles", "remove_saved.php"]
                        }
                    }
                }
            ]
        },
        {
            "name": "5. Settings",
            "item": [
                {
                    "name": "5.1 Get User Settings",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/settings/get_settings.php?user_id={{userId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["settings", "get_settings.php"],
                            "query": [{ "key": "user_id", "value": "{{userId}}" }]
                        }
                    }
                },
                {
                    "name": "5.2 Update User Settings",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"user_id\": {{userId}},\n  \"theme\": \"dark\",\n  \"notifications_enabled\": true,\n  \"language\": \"English (US)\",\n  \"interests\": [\"SCIENCE\", \"TECHNOLOGY\", \"HEALTH\"]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/settings/update_settings.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["settings", "update_settings.php"]
                        }
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost/Truthlense_backened",
            "type": "string"
        },
        {
            "key": "userId",
            "value": "1",
            "type": "string"
        }
    ]
}

